rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeProfile() {
      return ownProfile() && userProfile().active == true;
    }

    function studentProfile() {
      return activeProfile() && userProfile().role == 'student';
    }

    function staffProfile() {
      return activeProfile() && userProfile().role != 'student';
    }

    function ownStudent(studentId) {
      return studentProfile() && userProfile().profileId == studentId;
    }

    function ownNote(note) {
      return studentProfile() && note.studentId == userProfile().profileId;
    }

    function studentNoteDateAllowed(note) {
      return note.noteDateTs is timestamp
        && note.noteDateTs >= request.time - duration.value(2, 'd')
        && note.noteDateTs <= request.time;
    }

    function superAdmin() {
      return activeProfile() && userProfile().role in ['admin', 'priest', 'father_priest'];
    }

    function hasPermission(resource, action) {
      return superAdmin() || (activeProfile()
        && userProfile().permissions != null
        && userProfile().permissions[resource] != null
        && userProfile().permissions[resource][action] == true);
    }

    function canManageUsers() {
      return hasPermission('servants', 'manageUsers');
    }

    function canManageTargetUser(target) {
      return canManageUsers()
        && (target.role != 'priest' && target.role != 'father_priest' || superAdmin());
    }

match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canManageUsers() || resource.data.role == 'student');
      allow create: if canManageUsers();
      allow update: if (request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'updatedAt']))
        || canManageTargetUser(resource.data);
      allow delete: if canManageTargetUser(resource.data);
    }
    
    match /students/{studentId} {
      allow read: if staffProfile() || ownStudent(studentId) || resource.data.uid == request.auth.uid;
      allow create, update, delete: if canManageUsers();
    }

    match /visitation_notes/{noteId} {
      allow read: if staffProfile() || ownNote(resource.data);
      allow create: if (ownStudent(request.resource.data.studentId)
          && request.resource.data.type == 'spiritualDaily'
          && request.resource.data.reviewStatus == 'draft'
          && studentNoteDateAllowed(request.resource.data))
        || hasPermission('spiritualNotes', 'create');
      allow update: if (ownNote(resource.data)
          && resource.data.reviewStatus == 'draft'
          && ownStudent(request.resource.data.studentId)
          && request.resource.data.type == 'spiritualDaily'
          && request.resource.data.reviewStatus == 'draft'
          && studentNoteDateAllowed(request.resource.data))
        || (hasPermission('spiritualNotes', 'edit')
          && request.resource.data.reviewStatus == resource.data.reviewStatus)
        || (hasPermission('spiritualNotes', 'approve')
          && request.resource.data.reviewStatus == 'approved');
      allow delete: if hasPermission('spiritualNotes', 'archive');
    }

    match /attendance/{recordId} {
      allow read: if staffProfile() || ownNote(resource.data);
      allow write: if staffProfile() && hasPermission('system', 'edit');
    }

    match /coursework/{recordId} {
      allow read: if staffProfile() || ownNote(resource.data);
      allow write: if staffProfile() && hasPermission('system', 'edit');
    }

    match /exams/{recordId} {
      allow read: if staffProfile() || ownNote(resource.data);
      allow write: if staffProfile() && hasPermission('system', 'edit');
    }

    match /servants/{servantId} {
      allow read: if activeProfile() && (hasPermission('servants', 'view') || resource.data.uid == request.auth.uid);
      allow create: if hasPermission('servants', 'create');
      allow update: if hasPermission('servants', 'edit') && (resource.data.role != 'priest' || superAdmin());
      allow delete: if hasPermission('servants', 'archive') && (resource.data.role != 'priest' || superAdmin());
    }

match /{document=**} {
      allow read: if staffProfile();
      allow write: if activeProfile() && hasPermission('system', 'edit');
    }
    
  }
}
